"""Deterministic exposure analysis for observed device ports and services."""

from typing import Any, Dict, List, Optional
from app.services.risk_engine.models import ExposureResult

# Deterministic port exposure weighting table (Risk indicators, NOT vulnerabilities)
PORT_EXPOSURE_WEIGHTS: Dict[int, float] = {
    445: 35.0,   # SMB: High exposure (file-sharing service, lateral movement vector)
    22: 20.0,    # SSH: Administrative exposure (remote shell access)
    554: 20.0,   # RTSP: Media stream exposure (IP camera video feeds)
    80: 15.0,    # HTTP: Moderate exposure (unencrypted web management)
    8080: 15.0,  # HTTP-alt: Moderate exposure (unencrypted alternate web service)
    631: 10.0,   # IPP: Low/moderate exposure (CUPS network printing)
    53: 5.0,     # DNS: Low exposure (local DNS resolver)
    443: 5.0,    # HTTPS: Low exposure (encrypted web management)
    8443: 5.0,   # HTTPS-alt: Low exposure (encrypted alternate web service)
}

DEFAULT_UNKNOWN_PORT_WEIGHT: float = 10.0


class ExposureAnalyzer:
    """Evaluates service exposure subscore based on observed open network ports."""

    @staticmethod
    def analyze_ports(open_ports: List[Any]) -> ExposureResult:
        """
        Calculate deterministic exposure score (0.0 to 100.0) from a list of open ports.
        Accepts OpenPort ORM models, OpenPort schemas, or integer port lists.
        """
        if not open_ports:
            return ExposureResult(
                exposure_score=0.0,
                open_ports_count=0,
                risky_services_count=0,
                service_exposures=[],
                reasons=["No open services observed."],
            )

        # Extract port numbers
        port_list: List[int] = []
        for p in open_ports:
            if isinstance(p, int):
                port_list.append(p)
            elif hasattr(p, "port_number"):
                port_list.append(p.port_number)
            elif isinstance(p, dict) and "port_number" in p:
                port_list.append(p["port_number"])

        # Deduplicate ports
        unique_ports = sorted(list(set(port_list)))

        total_weight = 0.0
        service_exposures: List[Dict[str, Any]] = []
        reasons: List[str] = []
        risky_count = 0

        for port in unique_ports:
            weight = PORT_EXPOSURE_WEIGHTS.get(port, DEFAULT_UNKNOWN_PORT_WEIGHT)
            is_risky = weight >= 15.0
            if is_risky:
                risky_count += 1

            service_info = {
                "port": port,
                "weight": weight,
                "is_risky": is_risky,
                "description": _get_port_description(port),
            }
            service_exposures.append(service_info)
            reasons.append(f"Port {port}: {service_info['description']} (weight: {weight})")
            total_weight += weight

        # Sublinear saturation to ensure 0-100 clamping
        # Diminishing returns after 60 to prevent over-inflation
        clamped_score = min(100.0, total_weight)

        return ExposureResult(
            exposure_score=round(clamped_score, 2),
            open_ports_count=len(unique_ports),
            risky_services_count=risky_count,
            service_exposures=service_exposures,
            reasons=reasons,
        )


def _get_port_description(port: int) -> str:
    """Return factual descriptive rationale for observed port exposure."""
    descriptions = {
        445: "SMB file-sharing protocol active (high administrative exposure)",
        22: "SSH remote shell administrative service active",
        554: "RTSP unencrypted media streaming service active",
        80: "HTTP plaintext unencrypted web interface exposed",
        8080: "HTTP-alt unencrypted secondary web interface exposed",
        631: "IPP network printing service exposed",
        53: "DNS domain name resolution service active",
        443: "HTTPS encrypted web management service active",
        8443: "HTTPS-alt encrypted secondary web management interface active",
    }
    return descriptions.get(port, f"General TCP service on port {port}")

