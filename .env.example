# Cyber Home Shield - Environment Configuration Template
# Copy this file to backend/.env and customize for your environment.

APP_NAME="Cyber Home Shield"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# PostgreSQL Database Connection (AsyncPG)
# Example Local: postgresql+asyncpg://postgres:postgres@localhost:5432/cyber_home_shield
# Example Supabase: postgresql://postgres.xxxx:yourpassword@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/cyber_home_shield"

# CORS Security (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Authentication Secrets (Generate with: openssl rand -hex 32)
# HS256 is an HMAC signature algorithm used to verify stateless JWT bearer tokens
SECRET_KEY="replace-with-a-secure-random-at-least-32-character-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting & Telemetry
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SCANS_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_HONEYPOT_PER_MINUTE=60
TELEMETRY_RETENTION_DAYS=30

# NVIDIA Nemotron / Llama Security Advisor (Optional - falls back to deterministic rules if omitted)
NVIDIA_API_KEY=""
NVIDIA_MODEL="meta/llama-3.2-11b-vision-instruct"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_TIMEOUT=45.0

# Discovery Subsystem (Bounded, low-impact defensive discovery)
DISCOVERY_PROVIDER="network"
DISCOVERY_TIMEOUT=45.0
CONNECT_TIMEOUT=0.5
ICMP_PROBE_TIMEOUT=0.5
MAX_HOSTS=254
MAX_CONCURRENT_CHECKS=50
ENABLE_ACTIVE_ARP_SCAN=true
ACTIVE_ARP_SCAN_TIMEOUT=2.5

# Honeypot & Deception Subsystem (Safe by default: loopback sandbox)
# Default is strictly loopback (127.0.0.1). Enable LAN mode (0.0.0.0) via UI or set HONEYPOT_ALLOW_NON_LOCAL=true
HONEYPOT_ENABLED=false
HONEYPOT_BIND_HOST="127.0.0.1"
HONEYPOT_ALLOW_NON_LOCAL=false
HONEYPOT_HTTP_PORT=8088
HONEYPOT_SSH_PORT=2222
HONEYPOT_CAMERA_PORT=8554
HONEYPOT_DECOY_PROFILE="realistic_iot"
HONEYPOT_HTTP_BANNER="mini_httpd/1.30 01Jan2018"
HONEYPOT_SSH_BANNER="SSH-2.0-dropbear_2020.81"
HONEYPOT_CAMERA_BANNER="Boa/0.94.14rc21"
